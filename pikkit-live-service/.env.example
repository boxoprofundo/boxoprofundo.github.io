# Your Pikkit login. Set these directly in Railway's environment variable
# dashboard -- never commit them to git, never paste them into a chat.
PIKKIT_EMAIL=
PIKKIT_PASSWORD=

# A random secret string YOU make up (e.g. run `openssl rand -hex 24`).
# This protects the /live-summary endpoint from being called by anyone
# who finds the URL. It has nothing to do with your Pikkit password --
# it's only for this service.
SERVICE_TOKEN=

# Railway sets PORT automatically; only needed for local testing.
PORT=3000

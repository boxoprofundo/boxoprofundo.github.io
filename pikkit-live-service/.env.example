# Pikkit session credential.
#
# Pikkit has no password login (phone + SMS 2FA behind Cloudflare Turnstile),
# so there is nothing to automate a login with. Instead this service reuses a
# session from a browser you already logged into.
#
# To get it: log in at https://app.pikkit.com, then
#   DevTools -> Application -> Cookies -> app.pikkit.com -> session_id
# Copy that value here.
#
# Treat this exactly like a password -- it grants access to the account.
# Set it in Railway's dashboard/CLI, never commit it.
# It expires eventually; when it does, /live-summary returns HTTP 401 with
# "sessionExpired": true, and you repeat the step above.
PIKKIT_SESSION_ID=

# A random secret string YOU make up (e.g. run `openssl rand -hex 24`).
# This protects the endpoints from anyone who finds the URL. It has nothing
# to do with Pikkit -- it's only for this service.
SERVICE_TOKEN=

# Railway sets PORT automatically; only needed for local testing.
PORT=3000
